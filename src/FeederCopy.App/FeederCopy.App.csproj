<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\FeederCopy.Core\FeederCopy.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.*" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\AppIcon\app.ico" LogicalName="FeederCopy.Assets.app.ico" />
    <EmbeddedResource Include="Resources\AppIcon\soreco-logo.png" LogicalName="FeederCopy.Assets.soreco-logo.png" />
    <None Include="..\..\docs\sql\*.sql" Link="sql\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Forms\Shell\MainForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\Feeders\FeedersView.cs;Forms\Copy\CopyView.cs;Forms\Consumers\ConsumersView.cs;Forms\Settings\SettingsView.cs;Forms\Updates\UpdatesView.cs;Forms\BusSort\BusSortView.cs;Forms\Database\DatabaseView.cs">
      <SubType>UserControl</SubType>
    </Compile>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FeederCopy</AssemblyName>
    <Version>2.0.0</Version>
    <ApplicationIcon>Resources\AppIcon\app.ico</ApplicationIcon>
    <Product>Feeder kWh Copy</Product>
  </PropertyGroup>

</Project>
